# Um cluster MongoDB por dominio (o Atlas limita 512 MB por cluster).
# Se alguma destas variaveis ficar vazia, o dominio correspondente usa MONGODB_URI.
MONGODB_URI_ACCOUNTS=
MONGODB_URI_EXERCISES=
MONGODB_URI_TRAINING=
MONGODB_URI_FINANCE=
# Fallback usado quando as URIs por dominio nao estao definidas.
MONGODB_URI=
# The unique platform owner username is fixed by server authorization.
SUPER_ADMIN_USERNAME=rhuanspablo025
# Required only when creating the initial owner account; never commit a value here.
SUPER_ADMIN_PASSWORD=
SUPER_ADMIN_NAME=Proprietário
CRON_SECRET=
PAYMENT_PROVIDER=unconfigured
PAYMENT_ENVIRONMENT=unconfigured
ASAAS_API_KEY=
ASAAS_WEBHOOK_TOKEN=
ASAAS_AUTO_PAYOUT_ENABLED=false
ASAAS_PAYOUT_BANK_ACCOUNT_JSON=
# Optional, for one-time initial administrator creation only:
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
ADMIN_NAME=Administrador
# Optional, for one-time initial developer account creation only:
DEV_USERNAME=dev
DEV_PASSWORD=
DEV_NAME=DEV
